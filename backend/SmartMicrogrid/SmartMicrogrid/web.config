<?xml version="1.0" encoding="utf-8"?>
<!--
  File:    web.config
  Purpose: IIS hosting settings for this API. Publishing merges this file with
           the handler entries the SDK generates, so only the values we want to
           control ourselves are set here. stdout logging is on so that a
           configuration mistake on the server shows a real error in
           .\logs\stdout rather than a bare HTTP 500.30 page.
  Author:  <your name>
  Created: 2026
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- hostingModel="inprocess" runs the API inside the IIS worker process. -->
      <aspNetCore processPath="dotnet"
                  arguments=".\SmartMicrogrid.Api.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Secrets are NOT set here. They are set on the IIS site or the app
               pool so they never live in a file that is committed or zipped.
               See DEPLOYMENT.md for the required variable names. -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
