{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // The Android app talks to the HTTP binding on port 5062: the HTTPS
  // binding uses a self-signed developer certificate that a device will not
  // trust. With redirection on, every mobile request is bounced to
  // https://localhost:7068, which the emulator cannot reach.
  "UseHttpsRedirection": false
}
